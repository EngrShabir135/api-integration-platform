# Port the gateway listens on
PORT=4000

# Port the bundled mock backend (simulated CRM/Billing systems) listens on
MOCK_PORT=4001
START_MOCK_BACKEND=true

# Key required in the x-admin-key header to view /admin/metrics
ADMIN_KEY=admin-secret-change-me

# Example: credentials the gateway injects on the client's behalf when
# calling upstream APIs that need their own auth (see src/config/integrations.json).
# OPENWEATHER_API_KEY=your-upstream-key-here
